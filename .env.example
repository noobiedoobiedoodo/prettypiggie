# PrettyPiggie.com — Shopify Storefront & Server Environment Configuration
# Copy this file to .env.local (local) or Vercel Project Environment Variables (staging/production)

# Public Storefront API credentials (read-only public Storefront token — NEVER place Admin tokens here)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=prettypiggie.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-public-access-token

# Optional Server-Only Overrides (never exposed to browser bundles)
# SHOPIFY_STORE_DOMAIN=prettypiggie.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-private-delegate-token
#
# CRITICAL SECURITY RULE: If Shopify Admin API credentials are ever added for backend inventory/order checks,
# they MUST remain strictly server-only (e.g., SHOPIFY_ADMIN_ACCESS_TOKEN) and MUST NEVER use the NEXT_PUBLIC_ prefix.
