# PrettyPiggie.com — Shopify Storefront & Server Environment Configuration
# Copy this file to .env.local (local) or Vercel Project Environment Variables (staging/production)

# Server-Side Shopify Storefront API Credentials (PREFERRED — never bundled into browser JS)
SHOPIFY_STORE_DOMAIN=prettypiggie.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Server-Side Shopify Webhook HMAC Secret (MANDATORY for POST /api/webhooks/shopify — NEVER use NEXT_PUBLIC_)
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-signing-secret

# Optional Public Store Domain Display Hint (never place access tokens or secrets in NEXT_PUBLIC_* variables)
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=prettypiggie.myshopify.com

# Pre-GA Search Engine Indexing Guard (leave false on staging; set true ONLY upon General Availability sign-off)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Pretty Piggie Makeover Studio — AI image-to-image provider (server-only; NEVER use NEXT_PUBLIC_).
# Set ONE of the following keys. The studio fails closed (HTTP 503) when neither is configured.
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# MAKEOVER_AI_PROVIDER=gemini            # optional: gemini | openai (defaults to gemini when its key exists)
# MAKEOVER_GEMINI_MODEL=gemini-2.5-flash-image
# MAKEOVER_OPENAI_MODEL=gpt-image-1
# MAKEOVER_DAILY_BUDGET_USD=25           # hard daily spend cap (estimated per-generation cost is reserved before each call)

# CRITICAL SECURITY RULE: All Shopify access tokens, webhook secrets, and any future Admin API tokens
# MUST remain strictly server-only and MUST NEVER use the NEXT_PUBLIC_ prefix.
